# 只忽略仓库根的运行数据目录；写成 `data/` 会连安卓的
# app/src/main/java/com/xiaozhu/planner/data/（Room 实体/DAO）一起吞掉
/data/
__pycache__/
*.pyc
*.egg-info/
.env
.pytest_cache/
frontend/node_modules/
frontend/dist/
# 宣传物料（GitHub 主页/视频，体积大且与代码无关）
docs/marketing/
planner-release/
# 评测脚本与数据（LoCoMo 等，含 .db 与运行产物，不入库）
docs/research/
# 历史归档（运行时数据快照、旧发版产物，不入库）
archive/

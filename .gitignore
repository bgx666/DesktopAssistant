# 只忽略仓库根的运行数据目录；写成 `data/` 会连安卓的
# app/src/main/java/com/xiaozhu/planner/data/（Room 实体/DAO）一起吞掉
/data/
__pycache__/
*.pyc
*.egg-info/
.env
.pytest_cache/
frontend/node_modules/
frontend/dist/
promo/
planner-release/
# 评测脚本与数据（LoCoMo 等，含 .db 与运行产物，不入库）
eval_locomo/
# 数据迁移备份（运行时数据快照，不入库）
data_backup_*/

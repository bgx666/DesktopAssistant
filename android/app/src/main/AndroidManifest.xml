<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 提醒要能弹出来（Android 13+ 需要运行时授权） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 精确闹钟：日历到点提醒必须是"那一刻"，不能用不精确闹钟糊弄。
         没授权时降级成 setAndAllowWhileIdle（可能晚几分钟，但不会静默丢失）。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 重启/时间被改后要重排闹钟（AlarmManager 不持久化） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 语音输入（系统 SpeechRecognizer）。只录音，识别在本机/系统服务里做 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 心跳到点时要跑一轮（联网调模型 + 可能调工具）。用前台服务是因为
         后台进程随时会被冻住/杀掉，跑到一半断掉还会留下半截 buffer。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 语音识别是可选能力：没装语音服务的设备（部分平板/模拟器）也不该被市场过滤掉 -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Planner">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 在文件管理器/聊天软件里点开导出文件就能直接导入：
                 比"进设置页 → 选文件"少好几步，也绕开了存储权限（SAF 给的 URI 直接可读） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
            </intent-filter>
        </activity>

        <!-- 到点提醒（精确闹钟 → 通知） -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- 心跳到点（不精确闹钟即可；界面活着交给界面，否则起服务跑一轮） -->
        <receiver
            android:name=".proactive.HeartbeatReceiver"
            android:exported="false" />

        <!-- 后台跑一轮心跳：起来 → 想一轮 → 推通知 → 自己停 -->
        <service
            android:name=".proactive.HeartbeatService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 重启 / 改时间 / 覆盖安装后重排闹钟 + 补提醒 + 重复系列续期 -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>